{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.29.3",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.fable.market/*",
    "https://api.fable.trading/*",
    "https://intel.fable.market/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/locales/en.js",
        "src/locales/zh-CN.js",
        "src/locales/zh-TW.js",
        "src/locales/ja.js",
        "src/locales/ko.js",
        "src/locales/vi.js",
        "src/locales/th.js",
        "src/locales/id.js",
        "src/locales/factmeta.js",
        "src/config.js",
        "src/callout.js",
        "src/capture.js",
        "src/chart.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "icons/smart/*",
        "src/ui.css",
        "src/smart-names.json"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
